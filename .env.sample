# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=root_password
DB_NAME=moneylog
DB_PORT=3306

# Security (JWT)
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
ENCRYPTION_KEY=your_encryption_key_here

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Rackspace Email (SMTP / Nodemailer) Configuration
# Standard Server: secure.emailsrvr.com | Port: 465 (SSL) or 587 (TLS)
SMTP_HOST=secure.emailsrvr.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=notifications@moneylog.com
SMTP_PASS=your_rackspace_mailbox_password
# Note: Rackspace requires EMAIL_FROM to match or be an alias on the SMTP_USER mailbox
EMAIL_FROM="Money Log <notifications@moneylog.com>"

# Plaid Configuration
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_here
PLAID_ENV=sandbox
PLAID_COUNTRY_CODES=US,CA

FRONTEND_URL=http://localhost:3000

# Webhook configuration for Plaid
PLAID_WEBHOOK_URL=https://moneylog.com/api/webhook
